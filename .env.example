# API keys and tokens only. Everything else lives in config.json
# (copy config.example.json -> config.json and edit that file).
# Variables already set in the host panel/CI still win over this file.
# Save as UTF-8 (a BOM is still readable), avoid UTF-16.

# Zalo Bot token from Zalo Bot Creator.
ZALO_BOT_TOKEN=
# NVIDIA NIM key (required when the default model is NIM; optional otherwise — a
# fallback provider without a key is skipped).
NIM_API_KEY=
# DeepSeek key (required when the default model is DeepSeek).
DEEPSEEK_API_KEY=
# Tavily key (required while config.search.enabled is true).
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# Discord bot token — only needed for the Discord process (node src/discord.js).
# Leave it empty when you run the Zalo bot only.
DISCORD_BOT_TOKEN=
