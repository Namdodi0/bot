# API keys and tokens only. Everything else lives in config.discord.json
# (copy config.discord.example.json -> config.discord.json and edit that file).
# Variables already set in the host panel/CI still win over this file.
# Save as UTF-8 (a BOM is still readable), avoid UTF-16.

# Discord bot token.
DISCORD_BOT_TOKEN=
# NVIDIA NIM key (required when the default model is NIM; optional otherwise — a
# fallback provider without a key is skipped).
NIM_API_KEY=
# DeepSeek key (required when the default model is DeepSeek).
DEEPSEEK_API_KEY=
# Refuseless key (optional).
REFUSELESS_API_KEY=
# Abliteration AI key (optional; abliterated-model-large-flash).
ABLITERATION_API_KEY=
# Firecrawl key (primary web/image search; optional if Tavily is configured).
FIRECRAWL_API_KEY=
# Tavily key (search fallback; optional if Firecrawl is configured).
TAVILY_API_KEY=
