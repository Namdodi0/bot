# The panel/npm runs `npm install` automatically when it sees package.json.
# discord.js is the only runtime dependency (Discord process); typescript/@types/node are
# devDependencies used only by `npm run typecheck`.
# Skip devDependencies when installing on the server to keep it fast and avoid node_modules write-permission errors.
# Developers need `npm install --include=dev` for typecheck.
omit=dev
fund=false
audit=false
